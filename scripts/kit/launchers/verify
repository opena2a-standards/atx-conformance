#!/bin/sh
# Runs the Go verifier built for this machine against the fixtures in this folder, or against the paths given.
d=$(cd "$(dirname "$0")" && pwd)
case "$(uname -s)" in Darwin) os=darwin;; Linux) os=linux;; *) echo "unsupported system: $(uname -s); see README-START-HERE.md" >&2; exit 2;; esac
case "$(uname -m)" in arm64|aarch64) arch=arm64;; x86_64|amd64) arch=amd64;; *) echo "unsupported architecture: $(uname -m)" >&2; exit 2;; esac
b="$d/bin/$os-$arch/atx-verify"
[ -x "$b" ] || { echo "no binary for $os-$arch at $b" >&2; exit 2; }
if [ $# -eq 0 ]; then exec "$b" "$d/fixtures"; else exec "$b" "$@"; fi
