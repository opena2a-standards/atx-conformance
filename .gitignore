# Compiled Go binaries (verifiers and generator are `go run`-only).
# `go build ./verifiers/go` at the repository root writes `go` there, and
# `go build ./cmd/atx-verify` writes `atx-verify`.
/go
/atx-verify
cmd/atx-verify/atx-verify
verifiers/go/go
verifiers/go/verify
scripts/generate-fixtures/generate-fixtures
scripts/generate-fixtures/main

# The demo's MP4, written by docs/demo/record-atx-verify.sh; it is not committed here.
docs/demo/out/

# Python bytecode and venvs.
__pycache__/
*.py[cod]
.venv/
venv/

# OS noise.
.DS_Store
Thumbs.db

# Secrets (never commit). This repo intentionally contains only PUBLIC
# test-vector seeds (RFC 8032 / FIPS 204 known-answer tests), never real
# credentials; these patterns are defensive so a stray secret cannot be added.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
*.tfstate
*.tfvars
